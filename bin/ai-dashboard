      --opencode: #22d3ee;
      --opencode-soft: rgba(34, 211, 238, 0.16);
      --green: #22c55e;
      --shadow: 0 20px 48px rgba(0, 0, 0, 0.34);
    }

    * { box-sizing: border-box; }

    html, body { min-height: 100%; }

    body {
      margin: 0;
      color: var(--text);
      font-family: Inter, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 24%),
        radial-gradient(circle at top right, rgba(217, 70, 239, 0.16), transparent 24%),
        linear-gradient(180deg, #08111f 0%, #040913 55%, #02050a 100%);
    }

    button { font: inherit; }

    .page {
      max-width: 1700px;
      margin: 0 auto;
      padding: 24px 20px 64px;
    }

    .hero {
      padding: 22px 24px;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: linear-gradient(145deg, rgba(11, 18, 32, 0.94), rgba(8, 14, 28, 0.92));
      box-shadow: var(--shadow);
    }

    .hero-head {
      display: flex;
      gap: 18px;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(1.8rem, 3vw, 2.8rem);
      letter-spacing: -0.03em;
    }

    .hero p {
      margin: 10px 0 0;
      max-width: 72ch;
      color: var(--muted);
      line-height: 1.5;
    }

    .hero-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(140px, 1fr));
      gap: 12px;
      min-width: min(100%, 320px);
    }

    .metric {
      padding: 14px 16px;
      border-radius: 18px;
      border: 1px solid var(--line);
      background: rgba(8, 15, 31, 0.74);
    }

    .metric .label {
      color: var(--muted);
      font-size: 0.84rem;
      text-transform: uppercase;
