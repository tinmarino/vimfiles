#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK

"""
Render Claude and OpenCode session history as a terminal TUI or a local web UI.

The terminal view is the default and prints a fast Rich table. The web view is
opt-in via `--ui web` and starts a small localhost server with incremental
loading so the newest sessions appear first.

"""

from __future__ import annotations

# Import the shared data loader and UI dependencies
from argparse import ArgumentParser, Namespace
from base64 import b64encode
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from json import dumps as json_dumps
from os import read as os_read, write as os_write
from pathlib import Path
from re import compile as re_compile
from select import select as select_select
from shutil import which
from subprocess import DEVNULL, run as subprocess_run
from sys import path as sys_path, stdin as sys_stdin, stdout as sys_stdout
from termios import TCSADRAIN, tcgetattr, tcsetattr
from textwrap import wrap as text_wrap
from tty import setcbreak
from urllib.parse import parse_qs, urlparse
from webbrowser import open as webbrowser_open

from argcomplete import autocomplete
from rich import box
from rich.console import Console, Group
from rich.live import Live
from rich.panel import Panel
from rich.table import Table
from rich.text import Text

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys_path:
    sys_path.insert(0, str(SCRIPT_DIR))

from ai_dashboard_data import (
    DashboardStore,
    PATH_CLAUDE_PROJECTS,
    PromptRecord,
    SessionDetail,
    SessionSummary,
)


RE_MOUSE = re_compile(r"^\x1b\[<(\d+);(\d+);(\d+)([Mm])")


def parse_argument() -> Namespace:
    """ Return parsed CLI arguments. """
    # Build the command-line parser
    parser = ArgumentParser(
        prog="ai-dashboard",
        description=(
            "Browse Claude and OpenCode sessions in a Rich terminal table or a "
            "lazy-loaded local web UI."
        ),
    )
    parser.add_argument(
        "--ui",
        choices=("txt", "term", "web"),
        default="txt",
        help=(
            "Pick the plain-text, interactive-terminal, or web UI "
            "(default: txt, the machine-readable view for LLMs and pipes)."
        ),
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=100,
        help="Show at most N root sessions per source (0 means all).",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=0,
        help="Listen on this localhost TCP port for --ui web (0 picks a free port).",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help="Start the web server without opening a browser tab.",
    )
    parser.add_argument(
        "--dir",
        default="",
        metavar="SUBSTRING",
        help=(
            "Filter --ui txt sessions to those whose path contains SUBSTRING "
            "(case-insensitive), e.g. --dir myproject."
        ),
    )
    parser.add_argument(
        "--source",
        choices=("all", "claude", "opencode"),
        default="all",
        help="Restrict --ui txt output to one source (default: all).",
    )
    parser.add_argument(
        "--session",
        default="",
        metavar="ID",
        help=(
            "Print the prompts and nested subsessions of one root session "
            "in --ui txt instead of the list."
        ),
    )
    parser.add_argument(
        "--full",
        action="store_true",
        help="Show untruncated prompt text in --ui txt --session output.",
    )
    autocomplete(parser)
    return parser.parse_args()


def format_datetime_line(time_ms: int | None) -> str:
    """ Return one compact local datetime line. """
    # Handle missing timestamps early
    if time_ms is None:
        return "-"
    return DashboardStore.format_time_ms(time_ms)


def format_terminal_datetime_line(time_ms: int | None) -> str:
    """ Return one narrower datetime line for the terminal table. """
    # Handle missing timestamps early
    if time_ms is None:
        return "-"
    return DashboardStore.datetime_from_ms(time_ms).strftime("%y-%m-%d %H:%M")


def build_date_cell(summary: SessionSummary) -> Text:
    """ Return the two-line date cell for the terminal table. """
    # Build the date cell with end then start
    cell = Text()
    cell.append(format_terminal_datetime_line(summary.end_ms), style="bold white")
    cell.append("\n")
    cell.append(format_terminal_datetime_line(summary.start_ms), style="dim")
    return cell


def clamp_lines(value: str, width: int, max_lines: int) -> str:
    """ Wrap *value* into at most *max_lines* lines. """
    # Normalize paragraphs into wrapped lines
    stripped = value.strip() or "-"
    lines: list[str] = []
    was_truncated = False
    for paragraph in stripped.splitlines() or [stripped]:
        wrapped = text_wrap(paragraph, width=width, break_long_words=True)
        next_lines = wrapped or [""]
        if len(lines) + len(next_lines) > max_lines:
            was_truncated = True
        lines.extend(next_lines)
        if len(lines) >= max_lines:
            break

    # Clamp the output and add an ellipsis when needed
    lines = lines[:max_lines] or ["-"]
    if was_truncated and lines:
        last_line = lines[-1]
        if len(last_line) >= width:
            last_line = last_line[: max(1, width - 3)].rstrip()
        lines[-1] = f"{last_line}..."
    return "\n".join(lines)


def split_token(value: str, width: int = 18) -> str:
    """ Split a long token into fixed-width lines. """
    # Handle short values early
    if len(value) <= width:
        return value
    return "\n".join(
        value[index:index + width]
        for index in range(0, len(value), width)
    )


def build_folder_cell(summary: SessionSummary) -> Text:
    """ Return the basename-first folder cell for the terminal table. """
    # Show only the basename so the session-id column survives narrower terminals
    return Text(summary.folder_name, style="bold cyan")


def build_title_cell(summary: SessionSummary) -> Text:
    """ Return the wrapped title cell for the terminal table. """
    # Build a three-line title preview
    cell = Text()
    cell.append(clamp_lines(summary.title, width=48, max_lines=3), style="white")
    return cell


def build_id_cell(summary: SessionSummary) -> Text:
    """ Return the wrapped session-id cell for the terminal table. """
    # Show the full id across multiple lines so it stays copyable by selection
    cell = Text()
    cell.append(split_token(summary.session_id), style="bright_cyan")
    return cell


def build_summary_table(source: str, summaries: list[SessionSummary]) -> Table:
    """ Return one source table for the terminal UI. """
    # Pick the source-specific title and color
    title_style = "bold magenta" if source == "claude" else "bold cyan"
    title_text = "Claude" if source == "claude" else "OpenCode"

    # Build the Rich table in the Stock style
    table = Table(
        box=box.SIMPLE_HEAVY,
        header_style=title_style,
        title=f"[bold white]{title_text} - {len(summaries)} root sessions[/bold white]",
        show_lines=False,
        expand=True,
    )
    table.add_column("Date (end/start)", min_width=14, style="white")
    table.add_column("Folder", min_width=12)
    table.add_column("Title", min_width=32, ratio=2)
    table.add_column("Session ID", min_width=18)

    # Append one row per session summary
    for summary in summaries:
        table.add_row(
            build_date_cell(summary),
            build_folder_cell(summary),
            build_title_cell(summary),
            build_id_cell(summary),
        )
    return table


def render_term_snapshot(store: DashboardStore) -> None:
    """ Print the fast Rich terminal UI. """
    # Gather both source summaries once
    claude_summaries = store.list_summaries(source="claude")
    opencode_summaries = store.list_summaries(source="opencode")

    # Build the terminal renderables
    group = Group(
        build_summary_table("claude", claude_summaries),
        build_summary_table("opencode", opencode_summaries),
        Panel(
            "Use drag selection to copy text in the terminal.\n"
            "Run `ai-dashboard --ui web` for copy buttons, prompt details, and lazy loading.",
            border_style="green",
            title="Hint",
        ),
    )

    # Print the Rich dashboard
    console = Console()
    console.print(group)


def wrap_plain_lines(value: str, width: int, max_lines: int | None = None) -> list[str]:
    """ Return wrapped plain-text lines for *value*. """
    # Normalize the input into wrapped visual lines
    cleaned = DashboardStore.normalize_text(value)
    if not cleaned:
        return ["-"]
    lines: list[str] = []
    for paragraph in cleaned.splitlines() or [cleaned]:
        lines.extend(text_wrap(paragraph, width=max(4, width), break_long_words=True) or [""])
    if max_lines is not None:
        return lines[:max_lines] or ["-"]
    return lines or ["-"]


def pad_text(text: Text, width: int) -> Text:
    """ Right-pad *text* up to *width* cells. """
    plain_length = len(text.plain)
    if plain_length < width:
        text.append(" " * (width - plain_length))
    elif plain_length > width:
        text = Text(text.plain[:width])
    return text


def copy_to_clipboard(value: str) -> tuple[bool, str]:
    """ Copy *value* to the system clipboard via OSC52 (preferred) or helpers. """
    # Reject empty copies early
    if not value:
        return False, "Nothing to copy"

    # Prefer OSC52 so the copy works inside a Rich Live screen and over SSH
    if sys_stdout.isatty():
        encoded = b64encode(value.encode("utf-8")).decode("ascii")
        osc52 = f"\033]52;c;{encoded}\a"
        try:
            os_write(sys_stdout.fileno(), osc52.encode("ascii"))
        except OSError:
            sys_stdout.write(osc52)
            sys_stdout.flush()
        return True, "Copied (OSC52)"

    # Fall back to common clipboard helpers when stdout is not a terminal
    command_list = [
        ["wl-copy"],
        ["xclip", "-selection", "clipboard"],
        ["xsel", "--clipboard", "--input"],
    ]
    for command in command_list:
        if which(command[0]) is None:
            continue
        result = subprocess_run(
            command,
            check=False,
            input=value,
            text=True,
            stdout=DEVNULL,
            stderr=DEVNULL,
        )
        if result.returncode == 0:
            return True, f"Copied with {command[0]}"
    return False, "No clipboard helper found"


class InteractiveTermDashboard:
    """ Run the full-screen Rich terminal dashboard. """

    def __init__(self, store: DashboardStore):
        """ Capture the starting dashboard state. """
        self.store = store
        self.max_root_sessions = store.max_root_sessions
        self.console = Console()
        self.live: Live | None = None
        self.running = True
        self.source_names = ["claude", "opencode"]
        self.source = "claude"
        self.selected_index = {source: 0 for source in self.source_names}
        self.list_offset = {source: 0 for source in self.source_names}
        self.detail_scroll = 0
        self.expanded_prompts: set[int] = set()
        self.expanded_children: set[int] = set()
        self.hitboxes: list[dict] = []
        self.input_buffer = ""
        self.status = "Click rows or use j/k and arrows. q quits."

    def run(self) -> None:
        """ Enter the alternate-screen interactive dashboard. """
        file_descriptor = sys_stdin.fileno()
        old_termios = tcgetattr(file_descriptor)
        try:
            setcbreak(file_descriptor)
            sys_stdout.write("\033[?1000h\033[?1006h")
            sys_stdout.flush()
            with Live(
                self.render_screen(),
                console=self.console,
                screen=True,
                auto_refresh=False,
                transient=False,
            ) as live:
                self.live = live
                while self.running:
                    event = self.read_event(timeout=0.1)
                    if event is None:
                        continue
                    self.handle_event(event)
                    live.update(self.render_screen(), refresh=True)
        finally:
            sys_stdout.write("\033[?1000l\033[?1006l")
            sys_stdout.flush()
            tcsetattr(file_descriptor, TCSADRAIN, old_termios)

    def read_event(self, timeout: float) -> dict | None:
        """ Read one keyboard or mouse event from stdin. """
        # Keep filling the input buffer until one event can be parsed
        while True:
            event = self.parse_buffer_event()
            if event is not None:
                return event
            ready, _write, _error = select_select([sys_stdin], [], [], timeout)
            if not ready:
                return None
            chunk = os_read(sys_stdin.fileno(), 128).decode("utf-8", errors="ignore")
            if not chunk:
                return {"type": "key", "key": "q"}
            self.input_buffer += chunk

    def parse_buffer_event(self) -> dict | None:
        """ Parse and consume the next buffered event, if any. """
        # Handle an empty buffer early
        if not self.input_buffer:
            return None

        # Parse SGR mouse events
        mouse_match = RE_MOUSE.match(self.input_buffer)
        if mouse_match:
            button = int(mouse_match.group(1))
            xpos = int(mouse_match.group(2)) - 1
            ypos = int(mouse_match.group(3)) - 1
            suffix = mouse_match.group(4)
            self.input_buffer = self.input_buffer[mouse_match.end():]
            return {
                "type": "mouse",
                "button": button,
                "x": xpos,
                "y": ypos,
                "press": suffix == "M",
            }

        # Parse common escape-key sequences
        escape_map = {
            "\x1b[A": "up",
            "\x1b[B": "down",
            "\x1b[C": "right",
            "\x1b[D": "left",
            "\x1b[5~": "pageup",
            "\x1b[6~": "pagedown",
        }
        for sequence, key_name in escape_map.items():
            if self.input_buffer.startswith(sequence):
                self.input_buffer = self.input_buffer[len(sequence):]
                return {"type": "key", "key": key_name}

        # Wait for more bytes when the buffer contains an incomplete escape
        if self.input_buffer.startswith("\x1b") and len(self.input_buffer) == 1:
            return None

        # Fall back to one plain character keypress
        char = self.input_buffer[0]
        self.input_buffer = self.input_buffer[1:]
        if char == "\r":
            return {"type": "key", "key": "enter"}
        return {"type": "key", "key": char}

    def current_summaries(self) -> list[SessionSummary]:
        """ Return the summaries for the current source. """
        return self.store.list_summaries(self.source)

    def current_summary(self) -> SessionSummary | None:
        """ Return the currently selected root-session summary. """
        summaries = self.current_summaries()
        if not summaries:
            return None
        index = max(0, min(self.selected_index[self.source], len(summaries) - 1))
        self.selected_index[self.source] = index
        return summaries[index]

    def current_detail(self) -> SessionDetail | None:
        """ Return the detail payload for the selected session. """
        summary = self.current_summary()
        if summary is None:
            return None
        try:
            return self.store.get_detail(source=summary.source, session_id=summary.session_id)
        except Exception as exc:  # pylint: disable=broad-except
            self.status = f"Failed to load details: {exc}"
            return None

    def clear_detail_state(self) -> None:
        """ Reset local expansion and scroll state. """
        self.detail_scroll = 0
        self.expanded_prompts.clear()
        self.expanded_children.clear()

    def refresh_store(self) -> None:
        """ Rebuild the shared store and clamp the current selection. """
        self.store = DashboardStore(max_root_sessions=self.max_root_sessions)
        for source in self.source_names:
            summaries = self.store.list_summaries(source)
            if not summaries:
                self.selected_index[source] = 0
                self.list_offset[source] = 0
                continue
            self.selected_index[source] = min(self.selected_index[source], len(summaries) - 1)
            self.list_offset[source] = min(self.list_offset[source], max(0, len(summaries) - 1))
        self.clear_detail_state()
        self.status = "Refreshed session summaries."

    def switch_source(self, delta: int) -> None:
        """ Switch to the previous or next source tab. """
        current_index = self.source_names.index(self.source)
        self.source = self.source_names[(current_index + delta) % len(self.source_names)]
        self.clear_detail_state()
        self.status = f"Switched to {self.source}."

    def move_selection(self, delta: int) -> None:
        """ Move the selected root session by *delta*. """
        summaries = self.current_summaries()
        if not summaries:
            return
        old_index = self.selected_index[self.source]
        new_index = max(0, min(old_index + delta, len(summaries) - 1))
        if new_index == old_index:
            return
        self.selected_index[self.source] = new_index
        self.clear_detail_state()

    def scroll_detail_by(self, delta: int) -> None:
        """ Scroll the detail pane body. """
        self.detail_scroll = max(0, self.detail_scroll + delta)

    def copy_current_field(self, field_name: str) -> None:
        """ Copy one field from the current detail. """
        detail = self.current_detail()
        if detail is None:
            self.status = "No session selected."
            return
        value_map = {
            "id": detail.session_id,
            "folder": detail.cwd,
            "title": detail.title,
            "resume": detail.resume_command,
        }
        ok, message = copy_to_clipboard(value_map.get(field_name, ""))
        self.status = message if ok else f"Copy failed: {message}"

    def expand_all_children(self, expand: bool) -> None:
        """ Expand or collapse all child-session blocks. """
        detail = self.current_detail()
        if detail is None:
            return
        if expand:
            self.expanded_children = set(range(len(detail.children)))
            self.status = f"Expanded {len(detail.children)} child sessions."
        else:
            self.expanded_children.clear()
            self.status = "Collapsed child sessions."

    def toggle_prompt(self, prompt_index: int) -> None:
        """ Toggle one prompt block in the detail pane. """
        if prompt_index in self.expanded_prompts:
            self.expanded_prompts.remove(prompt_index)
            return
        self.expanded_prompts.add(prompt_index)

    def toggle_child(self, child_index: int) -> None:
        """ Toggle one child-session block in the detail pane. """
        if child_index in self.expanded_children:
            self.expanded_children.remove(child_index)
            return
        self.expanded_children.add(child_index)

    def activate_hitbox(self, hitbox: dict) -> None:
        """ Execute one mouse-activated action. """
        action = hitbox["action"]
        if action == "select-source":
            if self.source != hitbox["source"]:
                self.source = hitbox["source"]
                self.clear_detail_state()
            return
        if action == "select-row":
            if self.selected_index[self.source] != hitbox["index"]:
                self.selected_index[self.source] = hitbox["index"]
                self.clear_detail_state()
            return
        if action == "copy-id":
            self.copy_current_field("id")
            return
        if action == "copy-folder":
            self.copy_current_field("folder")
            return
        if action == "copy-title":
            self.copy_current_field("title")
            return
        if action == "copy-resume":
            self.copy_current_field("resume")
            return
        if action == "refresh":
            self.refresh_store()
            return
        if action == "expand-children":
            self.expand_all_children(True)
            return
        if action == "collapse-children":
            self.expand_all_children(False)
            return
        if action == "toggle-prompt":
            self.toggle_prompt(hitbox["index"])
            return
        if action == "toggle-child":
            self.toggle_child(hitbox["index"])
            return
        if action == "quit":
            self.running = False

    def handle_event(self, event: dict) -> None:
        """ Handle one keyboard or mouse event. """
        # Handle keypress events
        if event["type"] == "key":
            key_name = event["key"]
            if key_name in ("q", "Q"):
                self.running = False
                return
            if key_name in ("j", "down"):
                self.move_selection(1)
                return
            if key_name in ("k", "up"):
                self.move_selection(-1)
                return
            if key_name in ("h", "left"):
                self.switch_source(-1)
                return
            if key_name in ("l", "right"):
                self.switch_source(1)
                return
            if key_name in ("c", "i"):
                self.copy_current_field("id")
                return
            if key_name == "f":
                self.copy_current_field("folder")
                return
            if key_name == "t":
                self.copy_current_field("title")
                return
            if key_name == "u":
                self.scroll_detail_by(-3)
                return
            if key_name == "d":
                self.scroll_detail_by(3)
                return
            if key_name == "pageup":
                self.scroll_detail_by(-8)
                return
            if key_name == "pagedown":
                self.scroll_detail_by(8)
                return
            if key_name == "r":
                self.refresh_store()
                return
            if key_name == "e":
                self.expand_all_children(True)
                return
            if key_name == "E":
                self.expand_all_children(False)
                return
            return

        # Ignore mouse release events and only process presses/wheel
        if not event.get("press") and event["button"] < 64:
            return
        if event["button"] == 64:
            if event["x"] < self.left_width:
                self.move_selection(-1)
            else:
                self.scroll_detail_by(-3)
            return
        if event["button"] == 65:
            if event["x"] < self.left_width:
                self.move_selection(1)
            else:
                self.scroll_detail_by(3)
            return
        for hitbox in reversed(self.hitboxes):
            if hitbox["x1"] <= event["x"] <= hitbox["x2"] and hitbox["y1"] <= event["y"] <= hitbox["y2"]:
                self.activate_hitbox(hitbox)
                return

    def append_button(self, line: Text, x_pos: int, y_pos: int, label: str, action: str, style: str) -> int:
        """ Append one clickable button to *line* and register its hitbox. """
        button_text = f"[{label}]"
        line.append(button_text, style=style)
        self.hitboxes.append(
            {
                "action": action,
                "x1": x_pos,
                "x2": x_pos + len(button_text) - 1,
                "y1": y_pos,
                "y2": y_pos,
            }
        )
        return x_pos + len(button_text)

    def render_header(self, width: int) -> list[Text]:
        """ Build the fixed dashboard header lines. """
        lines: list[Text] = []

        # Render the source tabs and global buttons
        line0 = Text()
        line0.append(" AI Dashboard ", style="bold black on bright_white")
        x_pos = len(line0.plain)
        for source_name in self.source_names:
            line0.append(" ")
            x_pos += 1
            button_style = "bold black on magenta" if source_name == "claude" else "bold black on cyan"
            if self.source != source_name:
                button_style = "magenta" if source_name == "claude" else "cyan"
            label = f"{source_name.capitalize()} {len(self.store.list_summaries(source_name))}"
            button_text = f"[{label}]"
            line0.append(button_text, style=button_style)
            self.hitboxes.append(
                {
                    "action": "select-source",
                    "source": source_name,
                    "x1": x_pos,
                    "x2": x_pos + len(button_text) - 1,
                    "y1": 0,
                    "y2": 0,
                }
            )
            x_pos += len(button_text)
        line0.append("   ")
        x_pos += 3
        x_pos = self.append_button(line0, x_pos, 0, "Refresh", "refresh", "bold green")
        line0.append(" ")
        x_pos += 1
        self.append_button(line0, x_pos, 0, "Quit", "quit", "bold red")
        lines.append(pad_text(line0, width))

        # Render the status/help line
        status_text = (
            f"Source: {self.source} | j/k/arrows move | mouse clicks and wheel work | "
            f"i/c id  f folder  t title  u/d detail scroll  e/E children  r refresh  q quit | {self.status}"
        )
        lines.append(pad_text(Text(clamp_lines(status_text, width=width - 1, max_lines=1), style="dim"), width))
        lines.append(Text("-" * width, style="dim"))
        return lines

    def ensure_visible_selection(self, visible_rows: int) -> None:
        """ Adjust the current list offset to keep the selection visible. """
        index = self.selected_index[self.source]
        offset = self.list_offset[self.source]
        if index < offset:
            self.list_offset[self.source] = index
        elif index >= offset + visible_rows:
            self.list_offset[self.source] = max(0, index - visible_rows + 1)

    def build_left_row_line(
            self,
            summary: SessionSummary,
            title_line: str,
            id_line: str,
            date_text: str,
            folder_text: str,
            left_width: int,
            title_width: int,
            id_width: int,
            ) -> Text:
        """ Build one line in the left summary pane. """
        line = Text()
        line.append(f"{date_text:<14}", style="bold white")
        line.append(" ")
        line.append(f"{folder_text:<12}"[:12], style="bold cyan")
        line.append(" ")
        line.append(f"{title_line:<{title_width}}"[:title_width], style="white")
        line.append(" ")
        line.append(f"{id_line:<{id_width}}"[:id_width], style="bright_cyan")
        return pad_text(line, left_width)

    def render_left_pane(self, left_width: int, body_height: int, y_base: int) -> list[Text]:
        """ Build the left summary-pane lines. """
        lines: list[Text] = []
        summaries = self.current_summaries()
        pane_title = Text(f" {self.source.capitalize()} Sessions ", style="bold")
        pane_title.append(f" {len(summaries)} total", style="dim")
        lines.append(pad_text(pane_title, left_width))
        header = Text()
        header.append("Date", style="bold magenta")
        header.append(" " * 11)
        header.append("Folder", style="bold magenta")
        header.append(" " * 7)
        header.append("Title", style="bold magenta")
        header.append(" " * max(1, left_width - len(header.plain) - 10))
        header.append("ID", style="bold magenta")
        lines.append(pad_text(header, left_width))

        # Fill the pane with fixed two-line rows
        visible_rows = max(1, (body_height - 2) // 2)
        self.ensure_visible_selection(visible_rows)
        start = self.list_offset[self.source]
        end = min(len(summaries), start + visible_rows)
        title_width = max(16, left_width - 14 - 1 - 12 - 1 - 18 - 1)
        id_width = 18
        for visible_index, summary in enumerate(summaries[start:end]):
            actual_index = start + visible_index
            title_lines = wrap_plain_lines(summary.title, title_width, max_lines=2)
            while len(title_lines) < 2:
                title_lines.append("")
            id_lines = split_token(summary.session_id, width=id_width).splitlines()
            while len(id_lines) < 2:
                id_lines.append("")
            row_y = y_base + 2 + visible_index * 2
            line1 = self.build_left_row_line(
                summary,
                title_lines[0],
                id_lines[0],
                format_terminal_datetime_line(summary.end_ms),
                summary.folder_name,
                left_width,
                title_width,
                id_width,
            )
            line2 = self.build_left_row_line(
                summary,
                title_lines[1],
                id_lines[1],
                format_terminal_datetime_line(summary.start_ms),
                "",
                left_width,
                title_width,
                id_width,
            )
            if actual_index == self.selected_index[self.source]:
                line1.stylize("black on bright_white")
                line2.stylize("black on bright_white")
            else:
                line2.stylize("dim")
            lines.extend([line1, line2])
            self.hitboxes.append(
                {
                    "action": "select-row",
                    "index": actual_index,
                    "x1": 0,
                    "x2": left_width - 1,
                    "y1": row_y,
                    "y2": row_y + 1,
                }
            )

        while len(lines) < body_height:
            lines.append(Text(" " * left_width))
        return lines[:body_height]

    def render_right_pane(self, right_width: int, body_height: int, x_base: int, y_base: int) -> list[Text]:
        """ Build the right detail-pane lines. """
        detail = self.current_detail()
        if detail is None:
            return [pad_text(Text(" Select a session to inspect details.", style="dim"), right_width)] + [Text(" " * right_width) for _ in range(body_height - 1)]

        fixed_lines: list[Text] = []
        title_line = Text(f" Detail - {detail.folder_name} ", style="bold")
        fixed_lines.append(pad_text(title_line, right_width))
        for wrapped_line in wrap_plain_lines(detail.title, width=right_width - 1, max_lines=5):
            fixed_lines.append(pad_text(Text(wrapped_line, style="white"), right_width))

        # Render copy buttons as a fixed action bar
        action_line = Text()
        x_pos = 0
        for label, action, style in (
            ("Copy ID", "copy-id", "bold cyan"),
            ("Copy Folder", "copy-folder", "bold green"),
            ("Copy Title", "copy-title", "bold magenta"),
            ("Copy Resume", "copy-resume", "bold yellow"),
        ):
            if x_pos:
                action_line.append(" ")
                x_pos += 1
            x_pos = self.append_button(action_line, x_base + x_pos, y_base + 2, label, action, style)
        fixed_lines.append(pad_text(action_line, right_width))

        meta1 = Text(f"Folder: {detail.cwd_short or '-'}", style="cyan")
        meta1.append(f" | Model: {detail.model_label or '-'}", style="dim")
        fixed_lines.append(pad_text(Text(clamp_lines(meta1.plain, width=right_width - 1, max_lines=1), style="dim"), right_width))
        meta2 = Text(f"End: {format_datetime_line(detail.end_ms)}", style="white")
        meta2.append(f" | Start: {format_datetime_line(detail.start_ms)}", style="dim")
        fixed_lines.append(pad_text(Text(clamp_lines(meta2.plain, width=right_width - 1, max_lines=1), style="dim"), right_width))
        fixed_lines.append(Text("-" * right_width, style="dim"))

        # Build the scrollable body lines
        body_lines: list[Text] = []
        prompt_header = Text(f" Prompts ({len(detail.prompts)}) ", style="bold magenta")
        body_lines.append(pad_text(prompt_header, right_width))
        for prompt_index, prompt in enumerate(detail.prompts):
            prefix = "[-]" if prompt_index in self.expanded_prompts else "[+]"
            prompt_title = DashboardStore.build_title(prompt.text, fallback=f"Prompt {prompt_index + 1}")
            first_line_prefix = f"{prefix} {prompt_index + 1:02d} {format_datetime_line(prompt.time_ms)} "
            content_width = max(12, right_width - len(first_line_prefix) - 1)
            content_lines = wrap_plain_lines(prompt_title, width=content_width, max_lines=3)
            line1 = Text(first_line_prefix, style="white")
            line1.append(content_lines[0], style="white")
            body_lines.append(pad_text(line1, right_width))
            indent = " " * len(first_line_prefix)
            for continuation_line in content_lines[1:3]:
                body_lines.append(pad_text(Text(f"{indent}{continuation_line}", style="white"), right_width))
            if prompt_index in self.expanded_prompts:
                for line in wrap_plain_lines(prompt.text, width=max(12, right_width - 4)):
                    body_lines.append(pad_text(Text(f"    {line}", style="dim"), right_width))

        body_lines.append(Text(" " * right_width))
        child_header = Text(f" Subagents ({len(detail.children)}) ", style="bold cyan")
        body_lines.append(pad_text(child_header, right_width))
        child_action_line = Text()
        child_x = 0
        child_x = self.append_button(child_action_line, x_base + child_x, y_base + len(fixed_lines) + len(body_lines) - 1 - self.detail_scroll, "Expand all", "expand-children", "bold cyan")
        child_action_line.append(" ")
        child_x += 1
        self.append_button(child_action_line, x_base + child_x, y_base + len(fixed_lines) + len(body_lines) - 1 - self.detail_scroll, "Collapse all", "collapse-children", "bold cyan")
        body_lines.append(pad_text(child_action_line, right_width))
        for child_index, child in enumerate(detail.children):
            prefix = "[-]" if child_index in self.expanded_children else "[+]"
            child_first_prefix = f"{prefix} {child_index + 1:02d} "
            child_content_width = max(12, right_width - len(child_first_prefix) - 1)
            child_title_lines = wrap_plain_lines(child.title, width=child_content_width, max_lines=3)
            line1 = Text(child_first_prefix, style="white")
            line1.append(child_title_lines[0], style="white")
            body_lines.append(pad_text(line1, right_width))
            child_indent = " " * len(child_first_prefix)
            for continuation in child_title_lines[1:3]:
                body_lines.append(pad_text(Text(f"{child_indent}{continuation}", style="white"), right_width))
            if child_index in self.expanded_children:
                body_lines.append(pad_text(Text(f"    {child.description}", style="dim"), right_width))
                body_lines.append(pad_text(Text(f"    {child.cwd_short or '-'} | {child.model_label or child.kind}", style="dim"), right_width))
                body_lines.append(pad_text(Text(f"    {format_datetime_line(child.end_ms)} / {format_datetime_line(child.start_ms)}", style="dim"), right_width))

        # Slice the scrollable body into the visible window and register hitboxes
        visible_body = max(1, body_height - len(fixed_lines))
        max_scroll = max(0, len(body_lines) - visible_body)
        self.detail_scroll = max(0, min(self.detail_scroll, max_scroll))
        scrolled_body = body_lines[self.detail_scroll:self.detail_scroll + visible_body]
        rendered_lines = fixed_lines + scrolled_body

        # Register hitboxes only for visible prompt and child toggles
        # Build a helper to count how many body_lines each prompt summary takes
        def _prompt_summary_lines(prompt_index: int) -> int:
            """ Return the number of body lines the prompt summary occupies. """
            prompt = detail.prompts[prompt_index]
            prompt_title = DashboardStore.build_title(prompt.text, fallback=f"Prompt {prompt_index + 1}")
            first_line_prefix = f"[x] {prompt_index + 1:02d} {format_datetime_line(prompt.time_ms)} "
            content_width = max(12, right_width - len(first_line_prefix) - 1)
            return min(3, len(wrap_plain_lines(prompt_title, width=content_width, max_lines=3)))

        body_row = 0
        detail_line_index = 0
        visible_prompt_row_map: dict[int, int] = {}
        prompt_row_heights: dict[int, int] = {}
        for prompt_index, prompt in enumerate(detail.prompts):
            visible_prompt_row_map[prompt_index] = detail_line_index
            summary_height = _prompt_summary_lines(prompt_index)
            prompt_row_heights[prompt_index] = summary_height
            detail_line_index += summary_height
            if prompt_index in self.expanded_prompts:
                detail_line_index += len(wrap_plain_lines(prompt.text, width=max(12, right_width - 4)))
        detail_line_index += 2
        visible_child_row_map: dict[int, int] = {}
        detail_line_index += 1
        for child_index, child in enumerate(detail.children):
            visible_child_row_map[child_index] = detail_line_index
            detail_line_index += 1
            if child_index in self.expanded_children:
                detail_line_index += 3

        for prompt_index, row_index in visible_prompt_row_map.items():
            height = prompt_row_heights[prompt_index]
            visible_row = row_index - self.detail_scroll
            if visible_row + height > 0 and visible_row < visible_body:
                absolute_y = y_base + len(fixed_lines) + max(0, visible_row)
                absolute_y2 = y_base + len(fixed_lines) + min(visible_body - 1, visible_row + height - 1)
                self.hitboxes.append(
                    {
                        "action": "toggle-prompt",
                        "index": prompt_index,
                        "x1": x_base,
                        "x2": x_base + right_width - 1,
                        "y1": absolute_y,
                        "y2": absolute_y2,
                    }
                )
        for child_index, row_index in visible_child_row_map.items():
            visible_row = row_index - self.detail_scroll
            if 0 <= visible_row < visible_body:
                absolute_y = y_base + len(fixed_lines) + visible_row
                self.hitboxes.append(
                    {
                        "action": "toggle-child",
                        "index": child_index,
                        "x1": x_base,
                        "x2": x_base + right_width - 1,
                        "y1": absolute_y,
                        "y2": absolute_y,
                    }
                )

        while len(rendered_lines) < body_height:
            rendered_lines.append(Text(" " * right_width))
        return rendered_lines[:body_height]

    def render_screen(self):
        """ Build the full Rich screen for the current dashboard state. """
        self.hitboxes = []
        width = self.console.size.width
        height = self.console.size.height
        if width < 90 or height < 18:
            return Panel(
                "Terminal too small for the interactive dashboard.\nResize it or run with --ui web.",
                border_style="red",
                title="ai-dashboard",
            )

        header_lines = self.render_header(width)
        footer_height = 1
        body_height = max(8, height - len(header_lines) - footer_height)
        self.left_width = max(48, min(width * 44 // 100, width - 44))
        right_width = max(32, width - self.left_width - 3)

        left_lines = self.render_left_pane(self.left_width, body_height, y_base=len(header_lines))
        right_lines = self.render_right_pane(right_width, body_height, x_base=self.left_width + 3, y_base=len(header_lines))

        output_lines: list[Text] = []
        output_lines.extend(header_lines)
        for row_index in range(body_height):
            line = Text()
            line.append_text(pad_text(left_lines[row_index], self.left_width))
            line.append(" | ", style="dim")
            line.append_text(pad_text(right_lines[row_index], right_width))
            output_lines.append(line)
        footer = Text(clamp_lines(self.status, width=width - 1, max_lines=1), style="dim")
        output_lines.append(pad_text(footer, width))
        return Group(*output_lines)


# ---------------------------------------------------------------------------
# Plain-text UI (machine-readable view for LLMs and shell pipes)
# ---------------------------------------------------------------------------

# Cap one prompt block at this many characters unless --full is requested so a
# huge paste cannot flood the reader; --full lifts the cap entirely.
TXT_PROMPT_CAP = 1200


def sources_for_arg(source_arg: str) -> tuple[str, ...]:
    """ Return the ordered source names selected by *source_arg*. """
    # Expand the "all" shortcut into both concrete sources
    if source_arg == "all":
        return ("claude", "opencode")
    return (source_arg,)


def summary_matches_dir(summary: SessionSummary, needle: str) -> bool:
    """ Return True when *summary* lives under a path matching *needle*. """
    # An empty needle matches every session
    if not needle:
        return True
    lowered = needle.lower()
    haystacks = (summary.cwd, summary.cwd_short, summary.folder_name)
    return any(lowered in (value or "").lower() for value in haystacks)


def filter_summaries_by_dir(
        summaries: list[SessionSummary],
        needle: str,
) -> list[SessionSummary]:
    """ Return the summaries whose directory matches *needle*. """
    return [summary for summary in summaries if summary_matches_dir(summary, needle)]


def clamp_prompt_text(text: str, full: bool) -> str:
    """ Return the prompt body, capped unless *full* is requested. """
    # Normalize newlines so the output stays greppable line by line
    cleaned = DashboardStore.normalize_text(text) or "-"
    if full or len(cleaned) <= TXT_PROMPT_CAP:
        return cleaned
    hidden = len(cleaned) - TXT_PROMPT_CAP
    trimmed = cleaned[:TXT_PROMPT_CAP].rstrip()
    return f"{trimmed}\n[... {hidden} more characters; pass --full to show all]"


def format_txt_summary(summary: SessionSummary, index: int) -> str:
    """ Return one labelled plain-text list entry for *summary*. """
    # Assemble aligned key/value lines an LLM can scan or grep
    return "\n".join((
        f"[{index}] {summary.source} {summary.session_id}",
        f"    when   : {format_datetime_line(summary.start_ms)}"
        f" -> {format_datetime_line(summary.end_ms)}",
        f"    folder : {summary.folder_name}",
        f"    cwd    : {summary.cwd_short or '-'}",
        f"    title  : {DashboardStore.normalize_text(summary.title) or '-'}",
        f"    resume : {summary.resume_command or '-'}",
    ))


def format_txt_prompt(
        prompt: PromptRecord,
        order: int,
        full: bool,
        indent: str,
) -> str:
    """ Return one indented prompt block for the detail view. """
    # Show the timestamp header, then the (possibly capped) body
    when = format_datetime_line(prompt.time_ms)
    body = clamp_prompt_text(prompt.text, full)
    lines = [f"{indent}  prompt #{order} [{when}]"]
    lines.extend(f"{indent}    {line}" for line in body.split("\n"))
    return "\n".join(lines)


def format_txt_detail(detail: SessionDetail, depth: int, full: bool) -> str:
    """ Return the recursive plain-text detail for one session tree. """
    # Indent this node by its depth in the subsession tree
    indent = "  " * depth
    kind_label = detail.kind or "session"
    lines = [
        f"{indent}{kind_label}: {detail.source} {detail.session_id}",
        f"{indent}  when   : {format_datetime_line(detail.start_ms)}"
        f" -> {format_datetime_line(detail.end_ms)}",
        f"{indent}  folder : {detail.folder_name}",
        f"{indent}  cwd    : {detail.cwd_short or '-'}",
        f"{indent}  model  : {detail.model_label or '-'}",
        f"{indent}  title  : {DashboardStore.normalize_text(detail.title) or '-'}",
    ]

    # A subagent carries a distinct task description worth surfacing
    description = DashboardStore.normalize_text(detail.description)
    if description and description != DashboardStore.normalize_text(detail.title):
        lines.append(f"{indent}  desc   : {description}")
    if detail.resume_command:
        lines.append(f"{indent}  resume : {detail.resume_command}")

    # List the captured user prompts in chronological order
    lines.append(f"{indent}  prompts: {len(detail.prompts)}")
    for order, prompt in enumerate(detail.prompts, start=1):
        lines.append(format_txt_prompt(prompt, order, full, indent))

    # Recurse into nested subagent / subsession trees
    if detail.children:
        lines.append(f"{indent}  subsessions: {len(detail.children)}")
        for child in detail.children:
            lines.append(format_txt_detail(child, depth + 2, full))
    return "\n".join(lines)


def find_summary_source(
        store: DashboardStore,
        session_id: str,
        sources: tuple[str, ...],
) -> str | None:
    """ Return the source that owns *session_id*, or None when unknown. """
    # Scan the loaded root summaries of each candidate source
    for source in sources:
        for summary in store.list_summaries(source):
            if summary.session_id == session_id:
                return source
    return None


def locate_subagent_parent(session_id: str) -> str | None:
    """ Return the Claude root id whose subagents include *session_id*. """
    # Only Claude subagent transcripts are stored as on-disk meta files
    if not session_id.startswith("agent-"):
        return None
    matches = sorted(
        PATH_CLAUDE_PROJECTS.glob(f"*/*/subagents/{session_id}.meta.json")
    )
    if not matches:
        return None
    # .../projects/<project>/<root-id>/subagents/<id>.meta.json -> <root-id>
    return matches[0].parent.parent.name


def render_txt_list(store: DashboardStore, args: Namespace) -> None:
    """ Print the filtered plain-text session list. """
    printed_any = False
    for source in sources_for_arg(args.source):
        # Filter this source by the directory needle, then cap for display
        summaries = filter_summaries_by_dir(store.list_summaries(source), args.dir)
        if args.limit and args.limit > 0:
            summaries = summaries[:args.limit]

        # Build a header that records the active directory filter
        header = f"=== {source} ({len(summaries)} sessions"
        if args.dir:
            header += f", dir~={args.dir!r}"
        header += ") ==="
        print(header)

        # Emit each session as its own labelled block
        if not summaries:
            print("  (none)")
            print()
            continue
        for index, summary in enumerate(summaries, start=1):
            print(format_txt_summary(summary, index))
            print()
        printed_any = True

    # Point the reader at the detail view when the list has content
    if printed_any:
        print(
            "Tip: ai-dashboard --session <ID> shows prompts and subsessions "
            "(add --full for whole prompts)."
        )


def render_txt_detail(store: DashboardStore, args: Namespace) -> None:
    """ Print the recursive detail for one requested root session. """
    # Locate which source actually owns the requested id
    sources = sources_for_arg(args.source)
    source = find_summary_source(store, args.session, sources)
    if source is None:
        # Point subagent ids at their parent root, which the tool can open
        parent = locate_subagent_parent(args.session)
        if parent is not None:
            print(
                f"{args.session!r} is a subagent of root session {parent}. "
                f"Run: ai-dashboard --session {parent}"
            )
            return
        print(
            f"No root session found for id {args.session!r} in "
            f"{', '.join(sources)}. Run ai-dashboard --ui txt to list ids."
        )
        return

    # Load the full detail tree and print it
    detail = store.get_detail(source, args.session)
    print(format_txt_detail(detail, depth=0, full=args.full))


def render_txt_ui(store: DashboardStore, args: Namespace) -> None:
    """ Dispatch the plain-text list or single-session detail view. """
    # A session id switches from the list to the drill-down view
    if args.session:
        render_txt_detail(store, args)
        return
    render_txt_list(store, args)


def render_term_ui(store: DashboardStore) -> None:
    """ Run the interactive terminal UI when attached to a TTY. """
    if not (sys_stdin.isatty() and sys_stdout.isatty()):
        render_term_snapshot(store)
        return
    InteractiveTermDashboard(store).run()


def open_browser_url(url: str) -> None:
    """ Open *url* in the default browser. """
    # Prefer the desktop opener on Linux
    command = ["xdg-open", url]
    try:
        completed = subprocess_run(
            command,
            check=False,
            stdout=DEVNULL,
            stderr=DEVNULL,
        )
        if completed.returncode == 0:
            return
    except FileNotFoundError:
        pass

    # Fall back to Python's browser integration
    webbrowser_open(url)


def build_web_html() -> str:
    """ Return the lazily-loaded web dashboard HTML. """
    return """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI Dashboard</title>
  <style>
    :root {
      --bg: #07101c;
      --panel: rgba(11, 18, 32, 0.92);
      --panel-soft: rgba(17, 24, 39, 0.88);
      --panel-strong: rgba(15, 23, 42, 0.96);
      --line: rgba(148, 163, 184, 0.16);
      --line-strong: rgba(148, 163, 184, 0.28);
      --text: #eef4ff;
