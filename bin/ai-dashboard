<body>
  <div class="page">
    <section class="hero">
      <div class="hero-head">
        <div>
          <h1>AI Session Dashboard</h1>
          <p>Load the newest Claude and OpenCode sessions first, expand any row for prompts and child sessions, and copy any field with its button while keeping the text draggable.</p>
        </div>
        <div class="hero-meta" id="hero-meta"></div>
      </div>
      <div class="hero-foot">
        <span class="pill">Newest 10 sessions load first</span>
        <span class="pill">More sessions stream in behind them</span>
        <span class="pill">Expand a row to fetch full prompts lazily</span>
      </div>
    </section>
    <div class="sections" id="sections"></div>
  </div>
  <div class="toast" id="toast"></div>
  <script>
    const state = {
      sources: {
        claude: { label: "Claude", items: [], total: null, loaded: 0, done: false, errorText: "", listEl: null, countEl: null, loadingEl: null },
        opencode: { label: "OpenCode", items: [], total: null, loaded: 0, done: false, errorText: "", listEl: null, countEl: null, loadingEl: null },
      },
    };

    const sectionsEl = document.getElementById("sections");
    const heroMetaEl = document.getElementById("hero-meta");
    const toastEl = document.getElementById("toast");
    let toastTimer = null;

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function showToast(message) {
      toastEl.textContent = message;
      toastEl.classList.add("visible");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove("visible"), 1600);
    }

    async function copyText(value, label) {
      const text = String(value ?? "");
      if (!text) return;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          showToast(`Copied ${label}`);
          return;
        }
      } catch (error) {
      }

      const area = document.createElement("textarea");
      area.value = text;
      area.readOnly = true;
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.focus();
      area.select();
      const copied = document.execCommand("copy");
      document.body.removeChild(area);
      showToast(copied ? `Copied ${label}` : `Failed to copy ${label}`);
    }

    async function fetchJson(url) {
      const response = await fetch(url, { cache: "no-store" });
      if (!response.ok) {
        throw new Error(`HTTP ${response.status} for ${url}`);
      }
      return response.json();
    }

    function ensureSection(source) {
      const info = state.sources[source];
      if (info.listEl) return info;

      const section = document.createElement("section");
      section.className = `section ${source}`;
      section.innerHTML = `
        <div class="section-head">
          <h2>${escapeHtml(info.label)}</h2>
          <span class="pill" data-count>0 loaded</span>
        </div>
        <div class="section-body">
          <div class="column-header">
            <div>Date (end/start)</div>
            <div>Folder</div>
            <div>Title</div>
            <div>Session ID</div>
          </div>
          <div class="summary-list"></div>
          <div class="loading">summary batches</div>
        </div>
      `;
      info.listEl = section.querySelector(".summary-list");
      info.countEl = section.querySelector("[data-count]");
      info.loadingEl = section.querySelector(".loading");
      sectionsEl.appendChild(section);
      return info;
    }

    function updateHeroMeta() {
      const claude = state.sources.claude;
      const opencode = state.sources.opencode;
      const claudeTotal = claude.total === null ? "..." : claude.total;
      const opencodeTotal = opencode.total === null ? "..." : opencode.total;
      heroMetaEl.innerHTML = `
        <div class="metric">
          <span class="label">Claude</span>
          <span class="value">${claude.loaded}/${claudeTotal}</span>
        </div>
        <div class="metric">
          <span class="label">OpenCode</span>
          <span class="value">${opencode.loaded}/${opencodeTotal}</span>
        </div>
      `;
    }

    function updateSectionState(source) {
      const info = state.sources[source];
      if (!info.countEl) return;
      const totalText = info.total === null ? "..." : info.total;
      info.countEl.textContent = `${info.loaded}/${totalText} loaded`;
      if (info.errorText) {
        info.loadingEl.className = "empty";
        info.loadingEl.textContent = info.errorText;
        info.loadingEl.style.display = "block";
        updateHeroMeta();
        return;
      }
      if (info.done && info.total === 0 && !info.items.length) {
        info.loadingEl.className = "empty";
        info.loadingEl.textContent = `No ${info.label} sessions were found locally.`;
        info.loadingEl.style.display = "block";
        updateHeroMeta();
        return;
      }
      info.loadingEl.className = "loading";
      info.loadingEl.textContent = "summary batches";
      info.loadingEl.style.display = info.done ? "none" : "block";
      updateHeroMeta();
    }

    function renderSummaryField(valueHtml, subHtml, copyValue, copyLabel, extraClass = "") {
      return `
        <div class="summary-field ${extraClass}">
          <div class="summary-value ${extraClass.includes("title") ? "title-value" : ""} ${extraClass.includes("id") ? "id-value" : ""}">${valueHtml}</div>
          <div class="summary-sub">${subHtml}</div>
          <button class="copy-button" data-copy="${escapeHtml(copyValue)}" data-copy-label="${escapeHtml(copyLabel)}">Copy</button>
        </div>
      `;
    }

    function renderSummaryRow(item) {
      const dateCopy = `${item.end_text}\n${item.start_text}`;
      return `
        <details class="session-card" data-source="${escapeHtml(item.source)}" data-session-id="${escapeHtml(item.session_id)}">
          <summary>
            <div class="summary-grid">
              ${renderSummaryField(escapeHtml(item.end_text), escapeHtml(item.start_text), dateCopy, "dates")}
              ${renderSummaryField(escapeHtml(item.folder_name), escapeHtml(item.cwd_short || "-"), item.cwd, "folder")}
              ${renderSummaryField(escapeHtml(item.title), "Expand for prompts and child sessions", item.title, "title", "title")}
              ${renderSummaryField(escapeHtml(item.session_id), escapeHtml(item.source), item.session_id, "session id", "id")}
            </div>
          </summary>
          <div class="details-body"><div class="loading">session details</div></div>
        </details>
      `;
    }

    function renderPromptItem(prompt, promptKey) {
      const promptId = `prompt-${promptKey}`;
      return `
        <details class="prompt-item">
          <summary>
            <div class="summary-value">${escapeHtml(prompt.title || prompt.time_text || "Prompt")}</div>
            <div class="summary-sub">${escapeHtml(prompt.time_text || "-")}</div>
          </summary>
          <div class="prompt-body">
            <div class="detail-actions">
              <button class="copy-button static-copy" data-copy-target="${escapeHtml(promptId)}" data-copy-label="prompt">Copy</button>
            </div>
            <pre id="${escapeHtml(promptId)}" class="prompt-text">${escapeHtml(prompt.text)}</pre>
          </div>
        </details>
      `;
    }

    function renderPromptList(prompts, prefix) {
      return prompts.map((prompt, index) => renderPromptItem(prompt, `${prefix}-${index}`)).join("");
    }

    function renderChildSummary(child, childKey) {
      return `
        <details class="child-item" data-child-key="${escapeHtml(childKey)}">
          <summary>
            <div class="summary-value title-value">${escapeHtml(child.title)}</div>
            <div class="summary-sub">${escapeHtml(child.description || child.model_label || child.kind)}</div>
          </summary>
          <div class="child-body"><div class="loading">child details</div></div>
        </details>
      `;
    }

    function renderChildBody(child, childKey) {
      const detailCards = `
        <div class="detail-grid">
          <section class="detail-card">
            <h3>Title</h3>
            <div class="value">${escapeHtml(child.title)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(child.title)}" data-copy-label="child title">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Model</h3>
            <div class="value">${escapeHtml(child.model_label || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(child.model_label || "")}" data-copy-label="child model">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Session ID</h3>
            <div class="value id">${escapeHtml(child.session_id)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(child.session_id)}" data-copy-label="child id">Copy</button></div>
          </section>
        </div>
        <div class="detail-grid">
          <section class="detail-card">
            <h3>Description</h3>
            <div class="value">${escapeHtml(child.description || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(child.description || "")}" data-copy-label="child description">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Folder</h3>
            <div class="value">${escapeHtml(child.cwd_short || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(child.cwd)}" data-copy-label="child folder">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Dates</h3>
            <div class="value">${escapeHtml(child.end_text)}\n${escapeHtml(child.start_text)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(`${child.end_text}\n${child.start_text}`)}" data-copy-label="child dates">Copy</button></div>
          </section>
        </div>
      `;
      const promptPanel = child.prompts.length ? `
        <section class="panel">
          <div class="panel-head">
            <h3>Prompts Used</h3>
            <span class="pill">${child.prompts.length}</span>
          </div>
          <div class="prompt-list">${renderPromptList(child.prompts, `${childKey}-prompt`)}</div>
        </section>
      ` : "";
      return `${detailCards}${promptPanel}`;
    }

    function wireChildCards(container, detail) {
      const cards = [...container.querySelectorAll(".child-item")];
      cards.forEach((card, index) => {
        const child = detail.children[index];
        card.addEventListener("toggle", () => {
          if (!card.open || card.dataset.loaded === "1") {
            return;
          }
          const body = card.querySelector(".child-body");
          body.innerHTML = renderChildBody(child, `${detail.session_id}-child-${index}`);
          card.dataset.loaded = "1";
        });
      });
    }

    function renderDetail(detail) {
      const cards = `
        <div class="detail-grid">
          <section class="detail-card">
            <h3>Title</h3>
            <div class="value">${escapeHtml(detail.title)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.title)}" data-copy-label="title">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Folder</h3>
            <div class="value">${escapeHtml(detail.cwd_short || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.cwd)}" data-copy-label="folder">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Session ID</h3>
            <div class="value id">${escapeHtml(detail.session_id)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.session_id)}" data-copy-label="session id">Copy</button></div>
          </section>
        </div>
        <div class="detail-grid">
          <section class="detail-card">
            <h3>Dates</h3>
            <div class="value">${escapeHtml(detail.end_text)}\n${escapeHtml(detail.start_text)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(`${detail.end_text}\n${detail.start_text}`)}" data-copy-label="dates">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Model</h3>
            <div class="value">${escapeHtml(detail.model_label || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.model_label || "")}" data-copy-label="model">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Resume Command</h3>
            <div class="value">${escapeHtml(detail.resume_command || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.resume_command || "")}" data-copy-label="resume command">Copy</button></div>
          </section>
        </div>
        <div class="detail-grid">
          <section class="detail-card">
            <h3>Source File</h3>
            <div class="value">${escapeHtml(detail.source_file || "-")}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.source_file || "")}" data-copy-label="source file">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Kind</h3>
            <div class="value">${escapeHtml(detail.kind)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.kind)}" data-copy-label="kind">Copy</button></div>
          </section>
          <section class="detail-card">
            <h3>Source</h3>
            <div class="value">${escapeHtml(detail.source)}</div>
            <div class="detail-actions"><button class="copy-button static-copy" data-copy="${escapeHtml(detail.source)}" data-copy-label="source">Copy</button></div>
          </section>
        </div>
      `;

      const promptPanel = detail.prompts.length ? `
        <section class="panel">
          <div class="panel-head">
            <h3>Prompts Used</h3>
            <span class="pill">${detail.prompts.length}</span>
          </div>
          <div class="prompt-list">${renderPromptList(detail.prompts, `${detail.source}-${detail.session_id}`)}</div>
        </section>
      ` : `
        <section class="panel">
          <div class="panel-head">
            <h3>Prompts Used</h3>
            <span class="pill">0</span>
          </div>
          <div class="empty">No prompt text was captured for this session.</div>
        </section>
      `;

      const childPanel = detail.children.length ? `
        <section class="panel">
          <div class="panel-head">
            <h3>Child Sessions</h3>
            <span class="pill">${detail.children.length}</span>
          </div>
          <div class="child-list">${detail.children.map((child, index) => renderChildSummary(child, `${detail.session_id}-${index}`)).join("")}</div>
        </section>
      ` : "";

      return `${cards}<div class="stack">${promptPanel}${childPanel}</div>`;
    }

    async function loadDetail(card) {
      if (card.dataset.loading === "1") return;
      const loadedAt = Number(card.dataset.loadedAt || "0");
      if (card.dataset.loaded === "1" && Date.now() - loadedAt < 5000) return;
      card.dataset.loading = "1";
      const body = card.querySelector(".details-body");
      const source = card.dataset.source;
      const sessionId = card.dataset.sessionId;
      try {
        const payload = await fetchJson(`/api/detail?source=${encodeURIComponent(source)}&session_id=${encodeURIComponent(sessionId)}`);
        body.innerHTML = renderDetail(payload.item);
        wireChildCards(body, payload.item);
        card.dataset.loaded = "1";
        card.dataset.loadedAt = String(Date.now());
      } catch (error) {
        body.innerHTML = `<div class="empty">Failed to load details: ${escapeHtml(error.message)}</div>`;
      } finally {
        card.dataset.loading = "0";
      }
    }

    function appendSummaries(source, items) {
      const info = ensureSection(source);
      for (const item of items) {
        info.items.push(item);
        const wrapper = document.createElement("div");
        wrapper.innerHTML = renderSummaryRow(item);
        const card = wrapper.firstElementChild;
        card.addEventListener("toggle", () => {
          if (card.open) {
            loadDetail(card);
          }
        });
        info.listEl.appendChild(card);
      }
      info.loaded = info.items.length;
      updateSectionState(source);
    }

    async function loadSummaryBatch(source, offset, limit) {
      const payload = await fetchJson(`/api/summary?source=${encodeURIComponent(source)}&offset=${offset}&limit=${limit}`);
      const info = ensureSection(source);
      info.total = payload.total;
      appendSummaries(source, payload.items);
      info.done = info.loaded >= info.total;
      updateSectionState(source);
      return payload.items.length;
    }

    async function loadSource(source) {
      const firstBatch = 10;
      const backgroundBatch = 30;
      try {
        await loadSummaryBatch(source, 0, firstBatch);
        let offset = state.sources[source].loaded;
        while (offset < state.sources[source].total) {
          const loaded = await loadSummaryBatch(source, offset, backgroundBatch);
          if (!loaded) break;
          offset += loaded;
        }
      } catch (error) {
        const info = ensureSection(source);
        info.errorText = `Failed to load ${info.label}: ${error.message}`;
      } finally {
        state.sources[source].done = true;
        updateSectionState(source);
      }
    }

    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-copy]");
      if (button) {
        event.preventDefault();
        event.stopPropagation();
        const value = button.getAttribute("data-copy") || "";
        const label = button.getAttribute("data-copy-label") || "value";
        await copyText(value, label);
        return;
      }
      const targetButton = event.target.closest("[data-copy-target]");
      if (!targetButton) return;
      event.preventDefault();
      event.stopPropagation();
      const targetId = targetButton.getAttribute("data-copy-target") || "";
      const target = document.getElementById(targetId);
      const label = targetButton.getAttribute("data-copy-label") || "value";
      if (!target) {
        showToast(`Failed to copy ${label}`);
        return;
      }
      await copyText(target.textContent || "", label);
    });

    updateHeroMeta();
    loadSource("claude");
    loadSource("opencode");
  </script>
</body>
</html>
"""


def build_handler(store: DashboardStore):
    """ Return the request handler bound to *store*. """
    # Close over the shared store in a local handler class
    class DashboardHandler(BaseHTTPRequestHandler):
        """ Serve the AI dashboard page and JSON endpoints. """

        def log_message(self, format_str: str, *args) -> None:  # noqa: A003
            """ Silence per-request logging. """
            _ = format_str, args

        def do_GET(self) -> None:  # noqa: N802
            """ Serve GET requests for HTML and JSON resources. """
            # Route the request by path
            parsed = urlparse(self.path)
            if parsed.path == "/":
                self._send_html(build_web_html())
                return
            if parsed.path == "/api/summary":
                self._serve_summary(parsed.query)
                return
            if parsed.path == "/api/detail":
                self._serve_detail(parsed.query)
                return
            self.send_error(404, "Not found")

        def _serve_summary(self, query_string: str) -> None:
            """ Serve one summary page. """
            try:
                query = parse_qs(query_string)
                source = query.get("source", [""])[0]
                offset = int(query.get("offset", ["0"])[0] or 0)
                limit = int(query.get("limit", ["10"])[0] or 10)
                payload = store.get_summary_page(source=source, offset=offset, limit=limit)
            except ValueError as exc:
                self._send_json({"error": str(exc)}, status=400)
                return
            except Exception as exc:  # pylint: disable=broad-except
                self._send_json({"error": str(exc)}, status=500)
                return
            self._send_json(payload)

        def _serve_detail(self, query_string: str) -> None:
            """ Serve one lazily-loaded session detail. """
            try:
                query = parse_qs(query_string)
                source = query.get("source", [""])[0]
                session_id = query.get("session_id", [""])[0]
                payload = {"item": store.get_detail(source=source, session_id=session_id).to_dict()}
            except ValueError as exc:
                self._send_json({"error": str(exc)}, status=400)
                return
            except (KeyError, FileNotFoundError) as exc:
                self._send_json({"error": str(exc)}, status=404)
                return
            except Exception as exc:  # pylint: disable=broad-except
                self._send_json({"error": str(exc)}, status=500)
                return
            self._send_json(payload)

        def _send_html(self, document: str) -> None:
            """ Emit one HTML response. """
            body = document.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _send_json(self, payload: dict, status: int = 200) -> None:
            """ Emit one JSON response. """
            body = json_dumps(payload, ensure_ascii=False).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

    return DashboardHandler


def serve_web_ui(store: DashboardStore, args: Namespace) -> None:
    """ Start the lazy-loaded localhost web UI. """
    # Start the local dashboard server
    handler = build_handler(store)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), handler)

    # Print the URL and optionally open it in a browser
    url = f"http://127.0.0.1:{server.server_port}/"
    print(url)
    if not args.no_open:
        open_browser_url(url)

    # Keep serving until the user stops the command
    try:
        server.serve_forever(poll_interval=0.2)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


def ai_dashboard_main() -> None:
    """ Dispatch the requested ai-dashboard UI. """
    # Parse arguments and choose how many root sessions to load
    args = parse_argument()

    # A dir filter must scan every session; a plain list respects --limit
    store_limit = 0 if (args.ui == "txt" and args.dir) else args.limit
    store = DashboardStore(max_root_sessions=store_limit)

    # A single-id lookup starts cheap and only widens to a full parse on a miss
    if args.ui == "txt" and args.session and store_limit != 0:
        sources = sources_for_arg(args.source)
        if find_summary_source(store, args.session, sources) is None:
            store = DashboardStore(max_root_sessions=0)

    # Dispatch the selected UI
    if args.ui == "txt":
        render_txt_ui(store, args)
        return
    if args.ui == "term":
        render_term_ui(store)
        return
    serve_web_ui(store=store, args=args)


if __name__ == "__main__":
    ai_dashboard_main()
